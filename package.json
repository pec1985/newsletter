{
	"name": "newsletter",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:up": "docker compose up -d --wait",
		"db:setup": "bun scripts/setup.ts",
		"worker": "bun scripts/worker.ts",
		"test": "bun test",
		"knowledge:worker": "bun scripts/knowledge-worker.ts",
		"db:migrate": "bun scripts/migrate-ai-usage.ts && bun scripts/migrate-knowledge.ts && bun scripts/migrate-translation-approvals.ts && bun scripts/migrate-campaign-schedule.ts && bun scripts/migrate-api-keys.ts && bun scripts/migrate-unsubscribe-reasons.ts",
		"start": "node build",
		"db:init": "bun scripts/setup.ts --production"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^3.2.2",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-devtools-svelte": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"@vitejs/devtools": "^0.8.3",
		"@vitejs/devtools-rolldown": "^0.8.3",
		"@vitejs/devtools-vite": "^0.8.3",
		"@vitejs/devtools-vitest": "^0.8.3",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.1176.0",
		"dotenv": "^18.0.10",
		"marked": "^18.2.1",
		"postgres": "^4.1.1",
		"sanitize-html": "^2.18.2"
	}
}
